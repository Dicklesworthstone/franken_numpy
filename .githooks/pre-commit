#!/bin/sh
set -eu

ledger='docs/NEGATIVE_EVIDENCE.md'
if git diff --cached --quiet -- "$ledger"; then
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
common_dir=$(git rev-parse --git-common-dir)
case "$common_dir" in
    /*) ;;
    *) common_dir="$repo_root/$common_dir" ;;
esac

source_file="$repo_root/crates/fnp-conformance/src/bin/perf_ledger_preflight.rs"
source_id=$(git hash-object "$source_file")
preflight_bin="$common_dir/fnp-perf-ledger-preflight-$source_id"

if [ ! -x "$preflight_bin" ]; then
    rustc +nightly-2026-07-05 --edition 2024 "$source_file" -o "$preflight_bin"
fi

cd "$repo_root"
exec "$preflight_bin" --ledger "$ledger" --audit-staged
